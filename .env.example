PORT=4173
NODE_ENV=development
SHANHAI_DATABASE_ADAPTER=json
SHANHAI_DATA_DIR=.data
SHANHAI_ALLOWED_ORIGIN=https://example.com
SHANHAI_PUBLIC_BASE_URL=https://example.com
SHANHAI_MAX_JSON_BYTES=8388608
SHANHAI_MAX_UPLOAD_BYTES=5242880
SHANHAI_MEDIA_STORE=local
SHANHAI_RATE_LIMIT_WINDOW_MS=60000
SHANHAI_RATE_LIMIT_MAX=240
SHANHAI_RATE_LIMIT_STORE=memory
SHANHAI_ADMIN_EMAILS=admin@example.com

# Production beta defaults:
# NODE_ENV=production
# SHANHAI_DATABASE_ADAPTER=postgres
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_SSL=true
# SHANHAI_MEDIA_STORE=r2
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=<r2-access-key>
# R2_SECRET_ACCESS_KEY=<r2-secret-key>
# R2_BUCKET=shanhai-yingji
# R2_PUBLIC_BASE_URL=https://media.example.com
# SHANHAI_RATE_LIMIT_STORE=upstash
# UPSTASH_REDIS_REST_URL=https://<instance>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<upstash-token>
